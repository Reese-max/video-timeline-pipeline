GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3
GROQ_LANGUAGE=auto
GROQ_MAX_UPLOAD_MB=25

# Token Plan Subscription Key；不是一般隨用隨付 API Key。
MINIMAX_SUBSCRIPTION_KEY=
# 依帳戶所屬平台二選一，請勿留白後直接執行：
# 國際站：https://api.minimax.io/v1
# 中國站：https://api.minimaxi.com/v1
MINIMAX_BASE_URL=
# 先在 Token Plan 主控台確認可用模型；MiniMax-M3 僅為候選，不自動假設可用。
MINIMAX_MODEL=

# 可選：ChatGPT host 沒有 uploadFile 時，由遠端 MCP 把 MP4 分段存到 Drive。
# 正式使用請用 OAuth refresh token；GOOGLE_DRIVE_ACCESS_TOKEN 僅適合短期測試。
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_ACCESS_TOKEN=

# 語意檢索（--embed／--semantic）用；OpenRouter 的 embeddings 端點文件沒寫但可用
OPENROUTER_API_KEY=
# 舊的本機後端仍保留相容性，但本工作流固定以 groq 為主要方案。
TRANSCRIBE_BACKEND=groq
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
OPEN_NOTEBOOK_URL=http://127.0.0.1:5055
OPEN_NOTEBOOK_SOURCES_PATH=/api/sources
OPEN_NOTEBOOK_NOTEBOOK_ID=
OPEN_NOTEBOOK_PASSWORD=

# RSS 與 Pipeline 完成／失敗時的可選 JSON / Discord Webhook；留白即不通知。
RSS_NOTIFY_WEBHOOK=
DISCORD_WEBHOOK_URL=

# 每日／每週精選摘要郵件通知設定
NOTIFY_EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
EMAIL_FROM=digest@yourdomain.com
EMAIL_TO=
DIGEST_TIMEZONE=Asia/Taipei

# 供應商憑證（依 EMAIL_PROVIDER 選擇）
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Facebook 作者追蹤只支援你有權管理的 Page；不要把 Token 貼到對話或提交到 Git。
FACEBOOK_PAGE_ACCESS_TOKEN=
# 依 Meta App 目前使用版本調整；本版已依 v26.0 文件實作。
FACEBOOK_GRAPH_API_VERSION=v26.0

# 非自管公開 Facebook Page 可改用 Apify；Token 只放 Authorization header。
APIFY_API_TOKEN=
APIFY_FACEBOOK_ACTOR=apify~facebook-posts-scraper
# Actor 要求有限的 resultsLimit；本工具不再截斷結果，可依實際需求調高。
APIFY_FACEBOOK_RESULTS_LIMIT=1000000
# 每次 Actor run 的供應商費用上限（USD）；請依自己的方案調整。
APIFY_MAX_TOTAL_CHARGE_USD=1.00
APIFY_RUN_TIMEOUT_SECONDS=1800

# 公開 Instagram 作者 Reels 探索；使用 Bright Data API Key，不是 MCP URL。
# 作者盤點必須在 CLI 以 --instagram-max-items 明確指定有限結果上限（無 env 預設值）。
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_RUN_TIMEOUT_SECONDS=1800
# MCP 單篇採集預設拒絕；人工核准的公開 IG/Threads/Facebook 貼文 HTTPS 網址，以逗號分隔。
# 不是金額上限；啟用前仍須在供應商設定額度／支出控制。工具另需 allow_paid=true。
BRIGHTDATA_ALLOWED_POST_URLS=

# IG 公開下載失敗才使用；由使用者提供 Netscape cookies 絕對路徑，建議放 repo 外、權限 600。
# 不會自動讀取瀏覽器；原始 cookies 不會被覆寫，也不會傳給 ChatGPT。
YTDLP_INSTAGRAM_COOKIE_FILE=
# 通常留白，讓 curl_cffi 管理瀏覽器 User-Agent；僅在需要配合授權環境時指定。
YTDLP_INSTAGRAM_USER_AGENT=
