GROQ_API_KEY=
MINIMAX_API_KEY=
# 語意檢索（--embed／--semantic）用；OpenRouter 的 embeddings 端點文件沒寫但可用
OPENROUTER_API_KEY=
# large-v3 實測比 turbo 準（turbo 會漏字改義），慢約一倍
GROQ_MODEL=whisper-large-v3
GROQ_LANGUAGE=zh
# 轉錄後端：groq（預設）或 local（本機 faster-whisper，免金鑰、不受地區封鎖影響）
TRANSCRIBE_BACKEND=
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
MINIMAX_MODEL=MiniMax-M3
MINIMAX_BASE_URL=https://api.minimax.io/v1
OPEN_NOTEBOOK_URL=http://127.0.0.1:5055
OPEN_NOTEBOOK_SOURCES_PATH=/api/sources
OPEN_NOTEBOOK_NOTEBOOK_ID=
OPEN_NOTEBOOK_PASSWORD=
