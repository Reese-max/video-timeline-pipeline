GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3
GROQ_LANGUAGE=auto
GROQ_MAX_UPLOAD_MB=25

# Token Plan Subscription Key；不是一般隨用隨付 API Key。
MINIMAX_SUBSCRIPTION_KEY=
# 依帳戶所屬平台二選一，請勿留白後直接執行：
# 國際站：https://api.minimax.io/v1
# 中國站：https://api.minimaxi.com/v1
MINIMAX_BASE_URL=
# 先在 Token Plan 主控台確認可用模型；MiniMax-M3 僅為候選，不自動假設可用。
MINIMAX_MODEL=

# 視覺分析模式：video_mp4=整支 MP4 上傳給 MiniMax-M3（預設）；frames=舊抽幀逐張圖
ANALYZE_VISUAL_MODE=video_mp4
# video_mp4 專用：模型抽樣幀率 0.2–5（預設 1）、細節 low|default|high
ANALYZE_VIDEO_FPS=1
ANALYZE_VIDEO_DETAIL=default
# video_mp4：來源 >512MB 或 Files API 因大小拒絕時，先 ffmpeg 壓到約 400–480MB 再上傳；
# 壓縮失敗／仍過大則自動改抽幀備援（analysis_method=minimax_video_fallback_frames）。
# frames 模式仍是明確主路徑；上述備援只在 video_mp4 無法繼續時觸發。

# 可選：ChatGPT host 沒有 uploadFile 時，由遠端 MCP 把 MP4 分段存到 Drive。
# 正式使用請用 OAuth refresh token；GOOGLE_DRIVE_ACCESS_TOKEN 僅適合短期測試。
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_ACCESS_TOKEN=

# 語意檢索（--embed／--semantic）用；OpenRouter 的 embeddings 端點文件沒寫但可用
OPENROUTER_API_KEY=
# 舊的本機後端仍保留相容性，但本工作流固定以 groq 為主要方案。
TRANSCRIBE_BACKEND=groq
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
OPEN_NOTEBOOK_URL=http://127.0.0.1:5055
OPEN_NOTEBOOK_SOURCES_PATH=/api/sources
OPEN_NOTEBOOK_NOTEBOOK_ID=
OPEN_NOTEBOOK_PASSWORD=

# RSS 與 Pipeline 完成／失敗時的可選 JSON / Discord Webhook；留白即不通知。
RSS_NOTIFY_WEBHOOK=
DISCORD_WEBHOOK_URL=

# 每日／每週精選摘要郵件通知設定
NOTIFY_EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
EMAIL_FROM=digest@yourdomain.com
EMAIL_TO=
DIGEST_TIMEZONE=Asia/Taipei

# 供應商憑證（依 EMAIL_PROVIDER 選擇）
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Facebook 作者追蹤只支援你有權管理的 Page；不要把 Token 貼到對話或提交到 Git。
FACEBOOK_PAGE_ACCESS_TOKEN=
# 依 Meta App 目前使用版本調整；本版已依 v26.0 文件實作。
FACEBOOK_GRAPH_API_VERSION=v26.0

# 非自管公開 Facebook Page 可改用 Apify；Token 只放 Authorization header。
APIFY_API_TOKEN=
APIFY_FACEBOOK_ACTOR=apify~facebook-posts-scraper
# Actor 要求有限的 resultsLimit；本工具不再截斷結果，可依實際需求調高。
APIFY_FACEBOOK_RESULTS_LIMIT=1000000
# 每次 Actor run 的供應商費用上限（USD）；請依自己的方案調整。
APIFY_MAX_TOTAL_CHARGE_USD=1.00
APIFY_RUN_TIMEOUT_SECONDS=1800

# 公開 Instagram 作者 Reels 探索；使用 Bright Data API Key，不是 MCP URL。
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_RUN_TIMEOUT_SECONDS=1800
# 免費層共用每月 5,000 credits，每月 1 日 UTC 重置、不累積。
# 三條 Bright Data 路徑共用本機月額度；0 禁止新 trigger，格式錯誤會拒絕請求。
BRIGHTDATA_MONTHLY_CREDIT_LIMIT=4500
# 留白使用 ~/.local/state/video-timeline-pipeline/brightdata-credits.sqlite3，與 --root 無關。
BRIGHTDATA_CREDIT_LEDGER=
# MCP 新貼文 trigger 的 UTC 每日上限；ready 快取與 pending 續查不計。
BRIGHTDATA_POST_DAILY_LIMIT=20
# 空值或 apify；僅帳本預拒絕且 Apify 另獲放行時備援。
RSS_FACEBOOK_FALLBACK_PROVIDER=
# MCP 單篇採集預設拒絕；人工核准的公開 IG/Threads/Facebook 貼文 HTTPS 網址，以逗號分隔。
# 不是金額上限；啟用前仍須在供應商設定額度／支出控制。工具另需 allow_paid=true。
# 逗號分隔單篇白名單；任一項為 * 允許任何通過驗證的公開單篇貼文，仍需 allow_paid。
BRIGHTDATA_ALLOWED_POST_URLS=

# IG 公開下載失敗才使用；由使用者提供 Netscape cookies 絕對路徑，建議放 repo 外、權限 600。
# 不會自動讀取瀏覽器；原始 cookies 不會被覆寫，也不會傳給 ChatGPT。
YTDLP_INSTAGRAM_COOKIE_FILE=
# 通常留白，讓 curl_cffi 管理瀏覽器 User-Agent；僅在需要配合授權環境時指定。
YTDLP_INSTAGRAM_USER_AGENT=

# 成本護欄（可選）：每日預算以 COST_TIMEZONE 的「本地日」為界，預設 Asia/Taipei。
# COST_TIMEZONE 必須是有效 IANA 時區名稱；設定錯誤時預算檢查會明確失敗，不會退回 UTC。
# DAILY_BUDGET_USD 留白或 0 表示不限額；strict mode（BUDGET_HARD_STOP=true 且正預算）
# 另要求供應商端可執行上限（目前僅 Apify Actor run）；其他付費操作會在送出前拒絕。
COST_TIMEZONE=Asia/Taipei
DAILY_BUDGET_USD=
BUDGET_HARD_STOP=false
# FB 公開下載失敗才使用；Netscape cookies 絕對路徑（facebook.com），建議放 secrets/ 或 repo 外、權限 600。
YTDLP_FACEBOOK_COOKIE_FILE=
# 只有 YouTube 走這個 proxy（雲端 IP 會被要求登入）；例：家用電腦上的 scripts/youtube-egress/，http://<Tailscale IP>:18443。
YTDLP_YOUTUBE_PROXY=
# Durable MCP jobs and conservative media lifecycle (background=true).
# Queue deadline includes all download, FFmpeg and provider work.
MCP_JOB_TIMEOUT_SECONDS=3600
VIDEO_PROCESS_TIMEOUT_SECONDS=3600
VIDEO_API_TIMEOUT_SECONDS=900
MCP_MAX_STORAGE_MB=20480
MCP_MAX_JOB_MB=4096
MCP_RETENTION_HOURS=168
MCP_MEDIA_TTL_SECONDS=86400
# Enable after reviewing a dry-run retention plan. Only explicitly managed jobs
# can expire; pre-upgrade jobs are not adopted or removed automatically.
MCP_STORAGE_CLEANUP_ENABLED=0
# One fixed Unix epoch for migration only; never extend on each service restart.
MCP_LEGACY_MEDIA_UNTIL=0

# GitOps discovers the current Tailscale DNS name on each poll.
# A hostname change pauses deployment for connector review; it never kills active jobs.

# 影片分段模式：copy=直接剪開（stream copy，預設，不重新編碼）；transcode=重新編碼成 H.264。
# copy 失敗或分段驗證沒通過時會自動退回重新編碼；取消與逾時不會退回。
# 分段可能維持原編碼（例如 VP9），部分瀏覽器／iOS 無法播放；
# 需要到處都能播放的 H.264 分段請設 MCP_SEGMENT_MODE=transcode。
MCP_SEGMENT_MODE=copy
# transcode 模式（及 copy 退回時）的長邊上限；0 = 不縮放；非 0 時必須 >= 240 且為偶數。
MCP_SEGMENT_MAX_LONG_SIDE=1280
# transcode 模式的 x264 preset：superfast|veryfast|faster|fast|medium
MCP_SEGMENT_X264_PRESET=veryfast