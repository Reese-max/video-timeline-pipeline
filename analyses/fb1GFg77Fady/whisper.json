      "no_speech_prob": 0.055515870451927185
    },
    {
      "id": 16,
      "start": 51.2,
      "end": 53.2,
      "text": "是用来判断对方为什么问的",
      "avg_logprob": -0.18527722880244255,
      "compression_ratio": 1.2951388888888888,
      "no_speech_prob": 0.055515870451927185
    },
    {
      "id": 17,
      "start": 53.8,
      "end": 55.2,
      "text": "卡尼曼的双系统理论",
      "avg_logprob": -0.18527722880244255,
      "compression_ratio": 1.2951388888888888,
      "no_speech_prob": 0.055515870451927185
    },
    {
      "id": 18,
      "start": 55.6,
      "end": 58.8,
      "text": "把人的思维分成两层 直觉层和理性层",
